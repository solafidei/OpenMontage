{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/clip_ledger",
  "title": "Clip Ledger",
  "description": "Footage segments claimed by the reels of one batch. A claim is a segment (source + [in_seconds, out_seconds)) held by one reel; within-batch uniqueness means no two live claims may overlap on the same source. Per-project: this ledger deliberately does not persist across sittings.",
  "type": "object",
  "required": ["version", "claims"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "reel_id",
          "source",
          "in_seconds",
          "out_seconds",
          "status",
          "timestamp"
        ],
        "properties": {
          "claim_id": { "type": "string" },
          "reel_id": { "type": "string" },
          "source": { "type": "string" },
          "clip_id": { "type": ["string", "null"] },
          "in_seconds": { "type": "number", "minimum": 0 },
          "out_seconds": { "type": "number", "minimum": 0 },
          "status": { "type": "string", "enum": ["claimed", "released", "reconciled"] },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
